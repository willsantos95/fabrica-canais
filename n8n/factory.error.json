      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH v AS (\n  UPDATE videos SET status = 'failed', error = $2\n  WHERE n8n_execution_id = $1 AND status NOT IN ('published', 'scheduled', 'awaiting_approval')\n  RETURNING topic_id\n), tp AS (\n  UPDATE topics SET status = 'queued', priority = priority + 1000\n  WHERE id IN (SELECT topic_id FROM v)\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM v) AS videos_marcados;",
        "options": {
          "queryReplacement": "={{ [ String($json.execution.id), ($json.execution.lastNodeExecuted || '') + ': ' + ($json.execution.error?.message || 'erro desconhecido') ] }}"
        }
      },
      "id": "14f6e6c6-0fb6-4d13-ae1c-31bd574481cd",
      "name": "Marcar falha",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Fabrica DB"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = $('Config').first().json;\nconst text = [\n  `🚨 *Falha na fábrica*`,\n  `Workflow: ${e.workflow?.name || '?'}`,\n  `Nó: ${e.execution?.lastNodeExecuted || '?'}`,\n  `Erro: ${(e.execution?.error?.message || 'sem mensagem').slice(0, 500)}`,\n  e.execution?.url ? `Execução: ${e.execution.url}` : '',\n  'O tema voltou para o fim da fila.',\n].filter(Boolean).join('\\n');\nreturn [{ json: { number: e.alert_number, text } }];\n"
      },
      "id": "4307e36b-e6aa-4732-babd-f5cd172a7b77",
      "name": "Mensagem",
      "type": "n8n-nodes-base.code",
