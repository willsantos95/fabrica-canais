        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 10,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "a61702fb-1462-407b-9bbc-c0982e0f3840",
