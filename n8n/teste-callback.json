          "name": "Fabrica Worker"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "limitWait": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 10,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "de13b975-80be-422e-b8ca-d8eade1817b1",
