    {
      "parameters": {
        "jsCode": "// A URL precisa começar com o domínio público do n8n (WEBHOOK_URL), nunca com localhost.\nconst url = $execution.resumeUrl;\nif (/localhost|127\\.0\\.0\\.1/.test(url)) throw new Error('WEBHOOK_URL do n8n não configurada: ' + url);\nreturn [{ json: { ...$input.first().json, resume_url: url } }];\n"
      },
      "id": "30a0bb98-bcdb-4aa6-bbeb-0b8f21ecede3",
      "name": "Mostrar URL de retomada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.worker_url }}/jobs/checks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_id: 'teste-callback', idempotency_key: 'teste-callback-' + $execution.id, callback_url: $execution.resumeUrl, input: { media_url: $json.media_url, stage: 'teste' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a48366f7-9ffb-48cd-a06b-edb9ed13cf92",
      "name": "Worker: job de teste",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Fabrica Worker"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "limitWait": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 10,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "27195c1a-c411-4816-ab25-d329a0459e80",
      "name": "Aguardar worker",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        960,
