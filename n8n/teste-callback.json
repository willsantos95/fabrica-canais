          "id": "",
          "name": "Fabrica Worker"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 10,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "900deb92-b7b2-4771-a302-c177f1fc1fdc",
      "name": "Aguardar worker",
