    {
      "parameters": {
        "jsCode": "// A URL precisa começar com o domínio público do n8n (WEBHOOK_URL), nunca com localhost.\nconst url = $execution.resumeUrl;\nif (/localhost|127\\.0\\.0\\.1/.test(url)) throw new Error('WEBHOOK_URL do n8n não configurada: ' + url);\nreturn [{ json: { ...$input.first().json, resume_url: url } }];\n"
      },
      "id": "59018c3b-6607-4e92-a9a5-312aa03ecb3c",
      "name": "Mostrar URL de retomada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.worker_url }}/jobs/checks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_id: 'teste-callback', idempotency_key: 'teste-callback-' + $execution.id, callback_url: $execution.resumeUrl, input: { media_url: $json.media_url, stage: 'teste' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "6cbc15a0-2038-4623-b2fd-84398ae48c1a",
      "name": "Worker: job de teste",
      "type": "n8n-nodes-base.httpRequest",
