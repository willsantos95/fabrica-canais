    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nif (!b) throw new Error('O worker não conseguiu avisar o n8n em 10 min. Veja a linha \"callback falhou\" no log do serviço api/render.');\nreturn [{ json: { callback: 'OK — o n8n recebeu o aviso do worker', status: b.status, worker_result: b.result, erro: b.error || null } }];\n"
      },
