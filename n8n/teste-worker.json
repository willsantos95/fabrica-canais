{
  "name": "factory.teste-worker",
  "nodes": [
    {
      "parameters": {},
      "id": "a1",
      "name": "Executar teste",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://render.relampagodeofertas.shop/health",
        "options": {}
      },
      "id": "a2",
      "name": "Health do worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://render.relampagodeofertas.shop/jobs/thumbnail",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer COLE_O_WORKER_API_TOKEN" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": \"teste\",\n  \"idempotency_key\": \"teste-thumb-{{ $now.toMillis() }}\",\n  \"callback_url\": \"https://n8n.relampagodeofertas.shop/webhook/render-callback\",\n  \"input\": {\n    \"key_prefix\": \"testes/{{ $now.toFormat('yyyyMMdd-HHmmss') }}\",\n    \"options\": [\n      { \"image_url\": \"https://picsum.photos/seed/fabrica/1600/900\", \"lines\": [\"TESTE\", \"FUNCIONOU\"] }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "a3",
      "name": "Criar job de thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "render-callback",
        "options": {}
      },
      "id": "b1",
      "name": "Callback do worker",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 220],
      "webhookId": "render-callback"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.headers.authorization }}",
              "rightValue": "Bearer COLE_O_CALLBACK_TOKEN",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2",
      "name": "Token confere?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "d1", "name": "video_id", "value": "={{ $json.body.video_id }}", "type": "string" },
            { "id": "d2", "name": "tipo", "value": "={{ $json.body.type }}", "type": "string" },
            { "id": "d3", "name": "status", "value": "={{ $json.body.status }}", "type": "string" },
            { "id": "d4", "name": "resultado", "value": "={{ $json.body.result }}", "type": "object" },
            { "id": "d5", "name": "erro", "value": "={{ $json.body.error }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b3",
      "name": "Resultado do job",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 200]
    }
  ],
  "connections": {
    "Executar teste": { "main": [[{ "node": "Health do worker", "type": "main", "index": 0 }]] },
    "Health do worker": { "main": [[{ "node": "Criar job de thumbnail", "type": "main", "index": 0 }]] },
    "Callback do worker": { "main": [[{ "node": "Token confere?", "type": "main", "index": 0 }]] },
    "Token confere?": { "main": [[{ "node": "Resultado do job", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
