# Copie para .env (servidor) e preencha. Gere segredos com: openssl rand -hex 24

# Token que o n8n envia no header Authorization: Bearer <token>
WORKER_API_TOKEN=troque-por-um-segredo
# Token que o worker envia ao webhook de callback do n8n
CALLBACK_TOKEN=troque-por-outro-segredo

REDIS_PASSWORD=troque-por-um-segredo
# 127.0.0.1 = fila só no servidor. Para workers no seu PC, use o IP da Tailscale do servidor (100.x.y.z).
REDIS_BIND=127.0.0.1
# Porta publicada no servidor (troque se a 6379 já estiver em uso)
REDIS_PORT=6379
QUEUE_NAME=render
JOB_TIMEOUT_S=7200

STORAGE=s3
S3_BUCKET=fabrica
S3_ACCESS_KEY=fabrica-admin
S3_SECRET_KEY=troque-por-um-segredo-longo
S3_REGION=us-east-1
# Domínio público do MinIO no EasyPanel (porta 9000), usado nos links de preview
S3_PUBLIC_ENDPOINT=https://arquivos.relampagodeofertas.shop

# Vídeo
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
X264_PRESET=veryfast
KB_UPSCALE=2
CLIP_WORKERS=2
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# faster-whisper (checagem de pronúncia): tiny | base | small
WHISPER_MODEL=small

RENDER_REPLICAS=1

# Imagens dos planos (Nano Banana / Gemini). Crie a chave em aistudio.google.com
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK=gemini-2.5-flash-image
IMAGE_CONCURRENCY=3

# Páginas públicas exigidas pelo Google (/, /privacidade, /termos)
APP_PUBLIC_NAME=Fábrica de Vídeos
CONTACT_EMAIL=
