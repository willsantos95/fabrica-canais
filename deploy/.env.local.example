# Copie para .env.local no seu PC.
# A fila e o MinIO são os do servidor, acessados pela Tailscale (recomendado) ou pela internet.

REDIS_URL=redis://:SENHA_DO_REDIS@100.x.y.z:6379/0
QUEUE_NAME=render

STORAGE=s3
S3_ENDPOINT=https://arquivos.relampagodeofertas.shop
S3_BUCKET=fabrica
S3_ACCESS_KEY=fabrica-admin
S3_SECRET_KEY=mesmo-segredo-do-servidor
S3_REGION=us-east-1

CALLBACK_TOKEN=mesmo-segredo-do-servidor

# Imagens (o PC também gera imagens quando pega o job)
IMAGE_PROVIDERS=cloudflare,gemini
CF_ACCOUNT_ID=mesmo-do-servidor
CF_API_TOKEN=mesmo-do-servidor
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_STEPS=4
GEMINI_API_KEY=mesma-chave-do-servidor
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK=gemini-2.5-flash-image
IMAGE_CONCURRENCY=4

# Seu PC aguenta mais: aumente se tiver 8+ núcleos
CLIP_WORKERS=4
X264_PRESET=veryfast
KB_UPSCALE=2
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
WHISPER_MODEL=small
LOCAL_REPLICAS=1
